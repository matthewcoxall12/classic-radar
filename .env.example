# Public origin, with no trailing path.
SITE_URL=https://classicsgo.com

# Managed identity. Keep SUPABASE_SECRET_KEY server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Email/password is fail-closed. Enable only after Supabase Confirm Email,
# custom SMTP, the exact token-hash templates and CAPTCHA are configured.
AUTH_PASSWORD_ENABLED=false

# Turnstile is optional. The site key is public; the secret stays server-only.
TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me

# At least 32 random bytes, used only for privacy-preserving keyed hashes.
AUTH_HASH_PEPPER=replace_with_a_long_random_value

# Scheduled discovery runs from the trusted main-branch GitHub Actions
# workflow. It uses GitHub OIDC and needs no long-lived ingestion secret in
# Vercel. Local dry-runs use explicit DISCOVERY_SOURCE_* values at invocation
# time and never write to Supabase.

# Comma-separated, exact verified account emails allowed to use /admin.
# This is read on the server only and the admin area fails closed when unset.
ADMIN_EMAILS=matthewcoxall@classicsgo.com

# Public role addresses are centralised in lib/site-contact.ts. Keep noreply and
# notifications reserved for a future authenticated transactional mail service.

# Nominatim-compatible geocoder. A self-hosted or contracted endpoint can be
# switched in without a code release. The User-Agent must identify this app.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/
GEOCODER_USER_AGENT=ClassicsGo/1.0 (+https://classicsgo.com)
GEOCODER_COUNTRY_CODES=gb,ie,fr,de,it,es,pt,nl,be,lu,ch,at,dk,se,no,fi,is,pl,cz,sk,hu,si,hr,ro,bg,gr,ee,lv,lt,mt,cy,tr,rs,ba,al,me,mk,ad,mc,sm,li

# Server-only Stripe credentials. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Recurring GBP Price IDs configured in Stripe.
STRIPE_PRICE_MONTHLY=price_monthly_replace_me
STRIPE_PRICE_ANNUAL=price_annual_replace_me
# Optional: a £5-off, duration-once Coupon for the £19.99 founding first year.
STRIPE_FOUNDING_COUPON_ID=coupon_founding_replace_me
