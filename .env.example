NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=https://classicsgo.com

# Optional server-only billing. Keep disabled until the launch checks pass.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ROADBOOK_ANNUAL_PRICE_ID=
STRIPE_ROADBOOK_MONTHLY_PRICE_ID=
# Retain retired price IDs for existing subscription lifecycle webhooks.
STRIPE_ROADBOOK_LEGACY_PRICE_IDS=
# Existing SUPABASE_SERVICE_ROLE_KEY is also supported. Never use NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Sandbox only: requires VERCEL_ENV=preview or development. Production rejects test mode.
BILLING_MODE=live
# Dedicated disposable test account UUID; never use a real member or owner.
BILLING_TEST_USER_ID=
# Development localhost origin only. Preview uses VERCEL_URL automatically.
BILLING_TEST_SITE_URL=http://localhost:3000
